section(class='team-top-banner')
	div(class='team-top-banner__container')
		div(class='team-top-banner__container-item') 
			span(class='team-top-banner__title-league') NFL
			span(class='team-top-banner__title-first-name') NEW ENGLAND 
			span(class='team-top-banner__title-second-name') PATRIOTS
		div(class='team-top-banner__container-item' style='background-color:#4F657B')
			div(class='team-top-banner__picture')
				img(class='team-top-banner__avatar' src="images/matchup-logo1.svg", alt="")
			div(class='team-top-banner__text-container')
				span(class='team-top-banner__team-card-title-score') 0 - 2 - 0
				span(class='team-top-banner__team-card-title-data') 4TH AFC EAST
		div(class='team-top-banner__container-item')
			div(class='sbi-container team-top-banner__bg-container')
				div(class='sbi-item s-1-3 team-top-banner__bg-item') 
				div(class='sbi-item s-1-3 team-top-banner__bg-item') 
				div(class='sbi-item s-1-3 team-top-banner__bg-item') 
			div(class='sbi-container team-top-banner__row')
				div(class='sbi-item s-1-3') Conference
				div(class='sbi-item s-1-3') City
				div(class='sbi-item s-1-3') Started
			div(class='sbi-container team-top-banner__row')
				div(class='sbi-item s-1-3') AFC East
				div(class='sbi-item s-1-3') Boston, MA
				div(class='sbi-item s-1-3') 1960
			div(class='sbi-container team-top-banner__row')
				div(class='sbi-item s-1-3') Stadium
				div(class='sbi-item s-1-3') Last Game
				div(class='sbi-item s-1-3') Next Game
			div(class='sbi-container team-top-banner__row')
				div(class='sbi-item s-1-3') Gillette Stadium, MA
				div(class='sbi-item s-1-3') Lost 24-17 vs Miami
				div(class='sbi-item s-1-3') Sep 24, 2023, 1:00 PM at NY Jets				
