div(class='sticky-banner-desktop')
	div(class='sticky-banner-desktop__top-image-container')
		div(class='sticky-banner-desktop__brand-item')
			img(class='sticky-banner-desktop__logo-border', src="images/sidebar_top_border.svg", alt="")
			img(class='sticky-banner-desktop__logo', src="images/sidebar_top_logo_nfl.svg", alt="")
			h1 entertainment
			img(class='sticky-banner-desktop__logo-border', src="images/sidebar_bottom_border.svg", alt="")
	div(class='sticky-banner-desktop__video-container')
		video(autoplay, loop)
			source(src='video/nfl-xl.mp4' type='video/mp4')
	div(class='sticky-banner-desktop__breadcrumbs-container')
		div(class='sticky-banner-desktop__breadcrumbs')
			a(href="https://www.google.com/", class='sticky-banner-desktop__breadcrumbs-anchors')  nfl
			a(href="https://www.google.com/", class='sticky-banner-desktop__breadcrumbs-anchors')  nfl odds
