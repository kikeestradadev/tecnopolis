section(class='sticky-banner-mobile-container')
	div(class='sticky-banner-mobile')
		div(class='sticky-banner-mobile__content')
			div(class='sticky-banner-mobile__video-container')
				video(autoplay, loop, class='video-mobile')
					source(src='video/nfl-sm.mp4' type='video/mp4')
				video(autoplay, loop, class='video-tablet')
					source(src='video/nfl-md.mp4' type='video/mp4')
			div(class='sticky-banner-mobile__image-container')
				img(class='sticky-banner-mobile__border', src="images/sidebar_top_border.svg", alt="")
				img(class='sticky-banner-mobile__logo', src="images/sidebar_top_logo_nfl.svg", alt="")
				h1 lorem lorem 
				img(class='sticky-banner-mobile__border', src="images/sidebar_bottom_border.svg", alt="")
		div(class='mobile-breadcrumbs') 
			a(href="https://www.google.com/", class='mobile-breadcrumbs__anchors') nfl
			a(href="https://www.google.com/", class='mobile-breadcrumbs__anchors') nfl odds
