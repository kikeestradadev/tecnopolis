section(class='team-grid-news')
	div(class='team-grid-news__item')
		div(class='team-grid-left-news')
			div(class='team-grid-left-news__item')
				img(src="images/nfl-helmet-big-gold.svg", alt="", srcset="")
			div(class='team-grid-left-news__item')
				span(class='team-grid-left-news__title') PATRIOTS&nbsp; 
					span(class='team-grid-left-news__title-color') LATEST NEWS
				a(class='team-grid-left-news__anchor' href="#") SEE NEWS 
	div(class='team-grid-news__item')
		div(class='team-grid-right-news')
			div(class='team-grid-right-news__text-info')
				span(class='team-grid-right-news__text-title') Next Game
				span(class='team-grid-right-news__text-teams') 
					|Patriots 
