section(class='slider-module')
	div(class='slider-title-news')
		div(class='slider-title-news__title-container')
			div(class='slider-title-news__title-item')
				h1(class='slider-title-news__title-head') 
					img(src="images/nfl-helmet.svg", alt="", class='slider-title-news__ico')
					| Trending
			div(class='slider-title-news__title-item')
				a(href="#", class='slider-title-news__title-anchor') 
					span See All 
					span Trending News news
	div(class='small-size-slider-container')
		div(class='swiper small-size-slider')
			div(class='swiper-wrapper')
				-for(let i = 1; i<=8; i++ )
					a(href="https://www.google.com/" class='swiper-slide small-size-slider__item')
						div(class='small-size-slider__image-container', style="background-image: url('images/slide_item1.jpg')")
						div(class='small-size-slider__text-cointainer')
							span(class='small-size-slider__item-title') Deion Sanders advises Lamar Jackson to ‘stop explaining yourself to fools’ | UNDISPUTED
							span(class='small-size-slider__item-date') 10 HOURS AGO
