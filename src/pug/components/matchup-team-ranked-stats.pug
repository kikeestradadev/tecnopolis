					li(class='tabs-container__tab team-ranked-stats__tab is-active') OFFENSE
					li(class='tabs-container__tab team-ranked-stats__tab') DEFENSE
				div(class='team-ranked-stats__title')
					div(class='team-ranked-stats__title-item') STAT
					div(class='team-ranked-stats__title-item') RECORD
					div(class='team-ranked-stats__title-item') RANK
				div(class='tabs-container__panels team-ranked-stats__panels')
