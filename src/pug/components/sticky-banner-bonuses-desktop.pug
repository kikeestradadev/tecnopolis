div(class='sticky-banner-bonuses-desktop')
	div(class='sticky-banner-bonuses-desktop__top-container')
		div(class='sticky-banner-bonuses-desktop__top-container-image')
			img(src="https://insidersbettingdigest.com/wp-content/uploads/2024/02/Rectangle-9950.png", alt="banner")
		div(class='sticky-banner-bonuses-desktop__top-container-info')
			div(class='sticky-banner-bonuses-desktop__item-container-rating')
				div(style="--percentage : 20; --color: #979176" class="sticky-banner-bonuses-desktop__item-container-rating-circle")
					svg(height="128px" width="128px")
						circle(pathLength="100" cy="50%" cx="50%" r="57", class="sticky-banner-bonuses-desktop__item-container-rating-vector")
						circle(pathLength="100" cy="50%" cx="50%" r="57", class="sticky-banner-bonuses-desktop__item-container-rating-vector")
					span 9.7
			div(class='sticky-banner-bonuses-desktop__progress-bar-container')
				-for(let i = 1; i<=6; i++ )
					div(class='sticky-banner-bonuses-desktop__progress-bar-item-grid')
						div(class='sticky-banner-bonuses-desktop__progress-bar-label-container')
							span(class='sticky-banner-bonuses-desktop__progress-bar-label') Bonus
							span(class='sticky-banner-bonuses-desktop__progress-bar-label') 92%
						div(class='sticky-banner-bonuses-desktop__progresive-bar-container') 
							div(class='sticky-banner-bonuses-desktop__progresive-bar', style='width:50%')
			a(class='sticky-banner-bonuses-desktop__anchor-bet', href="#") Bet Now 
	div(class='sticky-banner-bonuses-desktop__breadcrumbs-container')
		div(class='sticky-banner-bonuses-desktop__breadcrumbs')
			a(href="https://www.google.com/", class='sticky-banner-bonuses-desktop__breadcrumbs-anchors')  nfl
			a(href="https://www.google.com/", class='sticky-banner-bonuses-desktop__breadcrumbs-anchors')  nfl odds
