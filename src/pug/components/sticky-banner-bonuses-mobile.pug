section(class='sticky-banner-bonuses-mobile-container')
	div(class='sticky-banner-bonuses-mobile')
		div(class='mobile-breadcrumbs') 
			a(href="https://www.google.com/", class='mobile-breadcrumbs__anchors') nfl
			a(href="https://www.google.com/", class='mobile-breadcrumbs__anchors') nfl odds
		div(class='sticky-banner-bonuses-mobile__top-image')
			picture
				source(srcset='https://insidersbettingdigest.com/wp-content/uploads/2024/02/betus-desk.jpg', alt='', media='(min-width:640px)')
				img(class='single-slider__image' src="https://insidersbettingdigest.com/wp-content/uploads/2024/02/slidermobile-betus.jpg", alt='')
		span(class='sticky-banner-bonuses-mobile__title') BetUS Sportsbook Review
		div(class='sticky-banner-bonuses-mobile__content')
			div(class='sticky-banner-bonuses-mobile__logo-container')
				img(src="https://insidersbettingdigest.com/wp-content/uploads/2024/02/Group-12495.svg", alt="logo")
			div(class='sticky-banner-bonuses-mobile__graphics-grid')
				div(class='sticky-banner-bonuses-mobile__graphics-grid-item')
					div(class='sticky-banner-bonuses-mobile__progress-bar-container')
						-for(let i = 1; i<=6; i++ )
							div(class='sticky-banner-bonuses-mobile__progress-bar-item-grid')
								div(class='sticky-banner-bonuses-mobile__progress-bar-label-container')
									span(class='sticky-banner-bonuses-mobile__progress-bar-label') Bonus
									span(class='sticky-banner-bonuses-mobile__progress-bar-label') 92%
								div(class='sticky-banner-bonuses-mobile__progresive-bar-container') 
									div(class='sticky-banner-bonuses-mobile__progresive-bar', style='width:50%')
				div(class='sticky-banner-bonuses-mobile__graphics-grid-item')
					div(class='sticky-banner-bonuses-mobile__item-container-rating')
						div(style="--percentage : 20; --color: #979176" class="sticky-banner-bonuses-mobile__item-container-rating-circle")
							svg(height="110px" width="110px")
								circle(pathLength="100" cy="50%" cx="50%" r="49", class="sticky-banner-bonuses-mobile__item-container-rating-vector")
								circle(pathLength="100" cy="50%" cx="50%" r="49", class="sticky-banner-bonuses-mobile__item-container-rating-vector")
							span 9.7
					a(href="#" class='sticky-banner-bonuses-mobile__anchor-bet') Bet Now