span(class='ufc-schedule-upcoming__title') Upcoming UFC Event
-for(let i = 1; i <= 1; i++)
	div(class='ufc-schedule-upcoming')
		div(class='ufc-schedule-upcoming__content')
			div(class='ufc-schedule-upcoming__matchup')
				div(class='ufc-schedule-upcoming__grid')
					div(class='ufc-schedule-upcoming__grid-item')
						img(src="images/ufc-schedule-fighter.png", alt="fighter")
					div(class='ufc-schedule-upcoming__grid-item')
						img(src="images/vrs.svg", alt="vrs", class='ufc-schedule-upcoming__vrs')
					div(class='ufc-schedule-upcoming__grid-item')
						img(src="images/ufc-schedule-fighter.png", alt="fighter")
			div(class='ufc-schedule-upcoming__label')
				div(class='ufc-schedule-upcoming__label-item')
					span(class='ufc-schedule-upcoming__label-event-name') UFC 289
					span(class='ufc-schedule-upcoming__label-fighters-name') Nunes 
						span(class='ufc-schedule-upcoming__label-fighters-name_vrs') vs 
						| Aldana
					span(class='ufc-schedule-upcoming__label-date') Saturday, Jun 10th
				div(class='ufc-schedule-upcoming__label-item')
					a(href="#", class='ufc-schedule-upcoming__label-anchor') FIGHT CARD
