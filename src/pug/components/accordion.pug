div(class='accordion-module')
	div(class='slider-title')
		div(class='slider-title__title-container')
			div(class='slider-title__title-item')
				h1(class='slider-title__title-head')= accordionData.title
	div(class='accordion')
		div(class='accordion-container')
			each item in accordionData.items
				div(class='accordion-container__wrapp')
					button(class='accordion-container__btn-acc')= item.question
					div(class='accordion-container__panel')
						p(class='accordion-container__text')= item.answer
