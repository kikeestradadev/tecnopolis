section(class='slider-module')
	div(class='slider-top-sportsbooks-container')
		span(class='slider-top-sportsbooks__title')= sliderTopSportsbooksData.title
			span(class='slider-top-sportsbooks__title-color')= sliderTopSportsbooksData.titleColor
		div(class='swiper slider-top-sportsbooks')
			div(class='swiper-wrapper')
				each item in sliderTopSportsbooksData.items
					div(class='swiper-slide slider-top-sportsbooks__item')
						span(class='slider-top-sportsbooks__item-first-counter')= item.rank
						div(class='slider-top-sportsbooks__item-container')
							div(class='slider-top-sportsbooks__item-container-brand')
								img(src=item.logo alt='')
								span(class='slider-top-sportsbooks__item-container-brand-description')= item.description
							div(class='slider-top-sportsbooks__item-container-rating')
								div(
									style=`--percentage : ${item.percentage}; --color: ${item.color}`
									class='slider-top-sportsbooks__item-container-rating-circle'
								)
									svg(height='93px' width='93px')
										circle(
											pathLength='100'
											cy='50%'
											cx='50%'
											r='42'
											class='slider-top-sportsbooks__item-container-rating-vector'
										)
										circle(
											pathLength='100'
											cy='50%'
											cx='50%'
											r='42'
											class='slider-top-sportsbooks__item-container-rating-vector'
										)
									span(class='cali-span')= item.score
							div(class='slider-top-sportsbooks__item-container-anchors-container')
								a(
									class='slider-top-sportsbooks__item-container-anchor-review'
									href=item.reviewHref
								)= item.reviewLabel
								a(
									class='slider-top-sportsbooks__item-container-anchor-bet'
									href=item.betHref
								)= item.betLabel
