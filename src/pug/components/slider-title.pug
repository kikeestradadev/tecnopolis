-
	const sliderTitleLabel =
		typeof categoryPage !== 'undefined' && categoryPage && categoryPage.title
			? categoryPage.title
			: sliderTitleData.title
section(class='title-page')
	div(class='title-page__title-container')
		div(class='title-page__title-item')
			h1(class='title-page__title-head')
				img(
					src=sliderTitleData.icon
					alt=sliderTitleData.iconAlt
					class='title-page__ico'
				)
				= sliderTitleLabel
