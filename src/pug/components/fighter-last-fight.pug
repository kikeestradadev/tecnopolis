div(class='fighter-last-fight')
	span(class='fighter-last-fight__title') last 
		span(class='fighter-last-fight__title-color') fight
	div(class='fighter-last-fight__fighters-container')
		img(src="images/vs-ico.svg", alt="vrs" , class='fighter-last-fight__vrs')
		div(class='fighter-last-fight__fighter_item')
			div(class='fighter-last-fight__avatar-container fighter-winner')
				img(src="images/last-fight-avatar.png", alt="avatar" , class='fighter-last-fight__avatar')
				img(src="images/winner-ico.svg", alt="winner flag" class='fighter-last-fight__winner-flag')
			span(class='fighter-last-fight__fighter-name') Jones
		div(class='fighter-last-fight__fighter_item')
			div(class='fighter-last-fight__avatar-container fighter-loser')
				img(src="images/last-fight-avatar.png", alt="avatar" , class='fighter-last-fight__avatar')
			span(class='fighter-last-fight__fighter-name') Jones
	span(class='fighter-last-fight__date') Feb. 09, 2020
