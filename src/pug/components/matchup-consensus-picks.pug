section(class='matchup-consensus-pick')
	div(class='matchup-consensus-pick__container')
		div(class='tabs-container matchup-consensus-pick__tabs-container')
			div(class='tabs-container matchup-consensus-pick__head-container')
				h2(class='matchup-consensus-pick__title') consensus pick
				ul(class='tabs-container__tabs matchup-consensus-pick__tabs' id='tabs')
					li(class='tabs-container__tab matchup-consensus-pick__tab is-active')
						img(class='consensus-pick-tab-logo consensus-logo-white', src="images/consensus-bet-ico-white.svg", alt="")
						img(class='consensus-pick-tab-logo consensus-logo-black', src="images/consensus-bet-ico-black.svg", alt="") 
						| Bet
					li(class='tabs-container__tab matchup-consensus-pick__tab') 
						img(class='consensus-pick-tab-logo consensus-logo-white', src="images/consensus-money-ico-white.svg", alt="")
						img(class='consensus-pick-tab-logo consensus-logo-black', src="images/consensus-money-ico-black.svg", alt="") 
						| Money
			div(class='tabs-container__panels matchup-consensus-pick__panels')
				div(class='tabs-container__panel matchup-consensus-pick__panel is-active')
					div(class='tabs-container matchup-consensus-pick__graphic-container sbi-grid full s-grid-3 row-gap')
