section(class='ufc-fighters-list')
	div(class='title-page')
		div(class='title-page__title-container')
			div(class='title-page__title-item')
				h1(class='title-page__title-head') 
					img(src="images/college2-ico.svg", alt="", class='title-page__ico')
					| UFC FIGHTERS
	div(class='ufc-fighters-list__search-component')
		div(class='sbi-grid full m-grid-2 row-gap')
			div(class='sbi-grid full s-grid-2 row-gap')
				select(class='ufc-fighters-list__select-item' id='selectItem1' name='select-item-1')
					option(class='ufc-fighters-list__select-item-option' value='lorem') GENDER
					option(class='ufc-fighters-list__select-item-option' value='lorem') lorem
					option(class='ufc-fighters-list__select-item-option' value='lorem') lorem
					option(class='ufc-fighters-list__select-item-option' value='lorem') lorem
				select(class='ufc-fighters-list__select-item' id='selectItem1' name='select-item-1')
					option(class='ufc-fighters-list__select-item-option' value='lorem') WEIGHT
					option(class='ufc-fighters-list__select-item-option' value='lorem') lorem
					option(class='ufc-fighters-list__select-item-option' value='lorem') lorem
					option(class='ufc-fighters-list__select-item-option' value='lorem') lorem
			div(class='ufc-fighters-list__input-search-section')
				input(class='ufc-fighters-list__input-search-item' type='text' placeholder='Name or nickname')
				button(class='ufc-fighters-list__button-search-item') Filter
		div(class='ufc-fighters-list__search-inputs')
		div(class='ufc-fighters-list__grid')
			-for(let i = 1; i <=10; i++)
				div(class='ufc-fighters-list__item')
					div(class='ufc-fighters-list__picture')
						img(class='ufc-fighters-list__avatar' src="images/fighter.png", alt="")
					span(class='ufc-fighters-list__nick-name') Bones
					span(class='ufc-fighters-list__name') JOSÉ HENRIQUE 
					span(class='ufc-fighters-list__last-name') MAGOMEDOV
					span(class='ufc-fighters-list__category') Heavyweight Division 
					span(class='ufc-fighters-list__record') 26-1-0 (W-L-D)
					a(href="#" class='ufc-fighters-list__profile') profile
		div(class='ufc-fighters-list__button-expand-container')
			button( class='ufc-fighters-list__button-expand') expand
