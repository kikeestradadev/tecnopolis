section(class='ufc-fighters-list')
	div(class='ufc-fighters-list__title')
	div(class='ufc-fighters-list__description')
	div(class='ufc-fighters-list__search-component')
		div(class='ufc-fighters-list__search-inputs')
		div(class='ufc-fighters-list__grid')
			div(class='sbi-grid full m-grid-4 row-gap')
				-for(let i = 0; i <=15; i++)
					div(class='ufc-fighters-list__item')
						div(class='ufc-fighters-list__picture')
						span(class='ufc-fighters-list__nick-name')
						span(class='ufc-fighters-list__name')
						span(class='ufc-fighters-list__last-name')
						span(class='ufc-fighters-list__last-category')
						span(class='ufc-fighters-list__last-record')
		div(class='ufc-fighters-list__button-expand-container')
