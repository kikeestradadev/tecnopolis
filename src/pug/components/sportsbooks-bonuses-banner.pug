section(class='sportsbooks-bonuses-banner')
	div(class='sportsbooks-bonuses-banner__content')
		div(class='sportsbooks-bonuses-banner__top-content')
			div(class='sportsbooks-bonuses-banner__grid')
				div(class='sportsbooks-bonuses-banner__grid-item')
					img(class='sportsbooks-bonuses-banner__grid-logo', src="https://insidersbettingdigest.com/wp-content/uploads/2024/02/Group-12494.svg", alt="logo")
				div(class='sportsbooks-bonuses-banner__grid-item')
					span(class='sportsbooks-bonuses-banner__sub-title') OFFERED 
						span(class='sportsbooks-bonuses-banner__sub-title-color') BONUSES
					div(class='sportsbooks-bonuses-banner__bonuses-grid')
						-for(let i=1; i<=6;i++)
							div(class='sportsbooks-bonuses-banner__bonuses-grid-item')
								img(src="https://insidersbettingdigest.com/wp-content/uploads/2024/02/Group-11840.svg", alt="")
								span(class='sportsbooks-bonuses-banner__bonuses-grid-label') Reload Bonus
		div(class='sportsbooks-bonuses-banner__label')
			div(class='sportsbooks-bonuses-banner__label-item')
				span(class='sportsbooks-bonuses-banner__label-event-name') PROMO:
				span(class='sportsbooks-bonuses-banner__label-fighters-name') 125% SIGN-UP BONUS 
				a(href='#' class='sportsbooks-bonuses-banner__label-date') Terms &amp; Conditions
			div(class='sportsbooks-bonuses-banner__label-item')
				a(href="#", class='sportsbooks-bonuses-banner__label-anchor') bet now
